[node name="NetInfo" type="Label" parent="Panel/NetworkPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.7, 0.8, 1)
theme_override_font_sizes/font_size = 13
text = "Ein Spieler hostet das Spiel, der andere tritt mit der angezeigten Adresse bei.\nBeide brauchen dieselbe Spielversion. Der Host startet das Match, sobald alle Spieler bereit sind.\nZuschauer belegen keinen Spieler-Slot und sehen das Match ohne mitzuspielen."
horizontal_alignment = 1
autowrap_mode = 2

[node name="HostHeader" type="Label" parent="Panel/NetworkPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.6, 0.25, 1)
theme_override_font_sizes/font_size = 17
text = "HOSTEN (SPIELER 1)"

[node name="HostRow" type="HBoxContainer" parent="Panel/NetworkPanel/Margin/VBox"]
